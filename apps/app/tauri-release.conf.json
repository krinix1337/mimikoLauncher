{
	"bundle": {
		"createUpdaterArtifacts": true
	},
	"build": {
		"features": ["updater"]
	},
	"app": {
		"security": {
			"capabilities": ["ads", "core", "plugins", "updater"]
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBKEY",
			"endpoints": [
				"https://github.com/krinix1337/mimikoLauncher/releases/latest/download/latest.json"
			],
			"windows": {
				"installMode": "quiet"
			}
		}
	}
}
